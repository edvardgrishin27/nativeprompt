#!/usr/bin/env python3
"""Safety-preserving launcher for the installed nativeprompt CLI.

OpenAI/Codex `improve` requests pass through the invariant-checked adapter.
Other subcommands and explicitly non-OpenAI models pass through unchanged to
the upstream executable.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path


def _upstream() -> Path:
    configured = os.environ.get("NATIVEPROMPT_UPSTREAM")
    candidates = [
        Path(configured).expanduser() if configured else None,
        Path.home() / ".local/bin/nativeprompt-upstream",
        Path.home()
        / ".local/share/uv/tools/nativeprompt/bin/nativeprompt",
    ]
    self_path = Path(__file__).resolve()
    for candidate in candidates:
        if candidate is None or not candidate.is_file():
            continue
        resolved = candidate.resolve()
        if resolved != self_path:
            return resolved
    raise RuntimeError(
        "Upstream nativeprompt executable not found. Set NATIVEPROMPT_UPSTREAM."
    )


def _is_non_openai(model: str | None) -> bool:
    if not model:
        return False
    lowered = model.casefold()
    return any(
        marker in lowered
        for marker in ("claude", "gemini", "qwen", "kimi", "grok")
    )


def _detected_family(upstream: Path) -> str | None:
    completed = subprocess.run(
        [str(upstream), "detect", "--json"],
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        return None
    try:
        report = json.loads(completed.stdout)
    except json.JSONDecodeError:
        return None
    family = report.get("family")
    return family.casefold() if isinstance(family, str) else None


def _prompt_from(args: argparse.Namespace) -> str | None:
    if args.prompt:
        return args.prompt
    if not sys.stdin.isatty():
        value = sys.stdin.read()
        if value.strip():
            return value
    return None


def _render(report: dict, show_metaprompt: bool) -> str:
    target = report.get("target", {})
    safety = report.get("safety", {})
    lines = [
        "=" * 66,
        "МОДЕЛЬ: %s" % (target.get("model_id") or target.get("family") or "?"),
        "БЕЗОПАСНОСТЬ: %s" % safety.get("status", "unknown"),
        "=" * 66,
    ]
    findings = report.get("findings") or []
    if findings:
        lines.append("ЧТО ИЗМЕНЕНО:")
        for index, finding in enumerate(findings, 1):
            lines.append(f"{index}. {finding['title']}")
            lines.append(f"   почему: {finding['why']}")
            lines.append(f"   источник: {finding['source']}")
    else:
        lines.append("ЧТО ИЗМЕНЕНО: исходный промпт уже достаточно ясен.")

    lines.extend(
        [
            "",
            "=" * 66,
            "УЛУЧШЕННЫЙ ПРОМПТ:",
            "=" * 66,
            report["improved"],
        ]
    )
    harness = report.get("harness")
    if harness:
        lines.extend(
            [
                "",
                "КАК ЗАПУСКАТЬ:",
                "  %s" % harness.get("command", ""),
                "  %s" % harness.get("why", ""),
                "  источник: %s" % harness.get("source", ""),
            ]
        )
        if harness.get("authorization"):
            lines.append("  граница: %s" % harness["authorization"])
    if show_metaprompt:
        lines.extend(
            [
                "",
                "=" * 66,
                "БЕЗОПАСНЫЙ МЕТА-ПРОМПТ:",
                "=" * 66,
                report["metaprompt"],
            ]
        )
    return "\n".join(lines)


def _safe_improve(argv: list[str], upstream: Path) -> int:
    parser = argparse.ArgumentParser(prog="nativeprompt improve")
    parser.add_argument("prompt", nargs="?")
    parser.add_argument("--model")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--no-metaprompt", action="store_true")
    args = parser.parse_args(argv)

    detected_family = None if args.model else _detected_family(upstream)
    if _is_non_openai(args.model) or (
        detected_family is not None and detected_family != "openai"
    ):
        completed = subprocess.run(
            [str(upstream), "improve", *argv],
            check=False,
        )
        return completed.returncode

    prompt = _prompt_from(args)
    if not prompt:
        print(
            'Дайте промпт: nativeprompt improve "<текст>" или через stdin.',
            file=sys.stderr,
        )
        return 2

    integration = Path(__file__).resolve().parent.parent
    adapter = (
        integration
        / "plugins/nativeprompt/skills/nativeprompt/scripts/improve_prompt.py"
    )
    command = [
        sys.executable,
        str(adapter),
        "--executable",
        str(upstream),
    ]
    if args.model:
        command.extend(["--model", args.model])
    completed = subprocess.run(
        command,
        input=prompt,
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        print(completed.stderr.strip() or completed.stdout.strip(), file=sys.stderr)
        return completed.returncode
    try:
        report = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        print(f"Safety adapter returned invalid JSON: {exc}", file=sys.stderr)
        return 1

    if args.json:
        json.dump(report, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
    else:
        print(_render(report, show_metaprompt=not args.no_metaprompt))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    try:
        upstream = _upstream()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 127

    if args and args[0] == "improve":
        return _safe_improve(args[1:], upstream)

    completed = subprocess.run([str(upstream), *args], check=False)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
